#!/bin/bash
# ArthurLegal macOS kurulumunun son adımı ('son' bileşeninin betiği; derle_macos.py pakete koyar).
# Kurulum yalnız kullanıcının ev klasörüne yapılır; betik kullanıcının yetkisiyle çalışır.
#  1. Bilgisayarın işlemcisine uyan Python'u (Apple Silicon ya da Intel) runtime/ olarak yerine koyar.
#  2. Seçilen uygulama açıksa kapatır: Claude Desktop (Windows kurulumundaki ClaudeKapat gibi), ChatGPT seçildiyse
#     ya da önceki seçimde vardıysa ChatGPT.
#  3. Seçilen modüllerin işaretlerini (secim/<kod>) kur.py'ye --moduller olarak, arayüz kutusunu (secim/arayuz-yeni)
#     --arayuz olarak, uygulama kutularını (secim/asistan-claude, secim/asistan-chatgpt) --asistan olarak geçirir:
#     Claude Desktop ve/veya ChatGPT kaydı, uygulamalar, masaüstü takma adları ve oturum açılışında güncelleme
#     (LaunchAgent) yazılır.
#  4. Paket seçilmediyse uyarır ve kaydı yapmaz; seçildiyse seçilen uygulamayı masa mesajıyla (ikisi seçildiyse yalnız
#     başlangıç panelini) ve başlangıç rehberini açar.
# Ev klasörü: ev klasörüne kurulumda $2 kullanıcının ev klasörüdür ($3 '/'); bulunamazsa $HOME.
KOK="$HOME/Library/Application Support/ArthurLegal"
for EV in "$2" "$3"; do
  if [ -n "$EV" ] && [ "$EV" != "/" ] && [ -d "$EV/Library/Application Support/ArthurLegal/bin" ]; then
    KOK="$EV/Library/Application Support/ArthurLegal"
    # Betik yönetici olarak çalıştırıldıysa kayıt ve kısayollar ev klasörünün sahibi adına yazılır.
    SAHIP=$(/usr/bin/stat -f %Su "$EV" 2>/dev/null)
    if [ "$(id -u)" = "0" ] && [ -n "$SAHIP" ] && [ "$SAHIP" != "root" ]; then
      exec /usr/bin/sudo -u "$SAHIP" -H /bin/bash "$0" "$@"
    fi
    break
  fi
done
GUNLUK="$KOK/veri/gunluk/kurulum-pkg.log"
mkdir -p "$(dirname "$GUNLUK")"
exec >>"$GUNLUK" 2>&1
echo "$(date '+%Y-%m-%d %H:%M:%S') postinstall: kullanıcı $(id -un) ($(id -u)), HOME=$HOME, paket=$1, hedef=$2, cilt=$3, kök=$KOK"
if [ ! -f "$KOK/bin/al.py" ]; then
  echo "kurulum klasörü bulunamadı: $KOK"
  exit 1
fi

if [ "$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null)" = "1" ]; then MIMARI=arm64; else MIMARI=x86_64; fi
if [ -d "$KOK/runtime-$MIMARI" ]; then
  rm -rf "$KOK/runtime"
  mv "$KOK/runtime-$MIMARI" "$KOK/runtime"
fi
rm -rf "$KOK/runtime-arm64" "$KOK/runtime-x86_64"
echo "Python: $MIMARI ($("$KOK/runtime/bin/python3" -c 'import platform; print(platform.machine())' 2>&1))"

# Arayüz: 'arayuz-yeni' kutusu işaretliyse ArthurLegal Masası, değilse uygulamanın kendi sohbeti (klasik). İşareti modül
# değildir.
ARAYUZ=klasik
[ -e "$KOK/secim/arayuz-yeni" ] && ARAYUZ=yeni
rm -f "$KOK/secim/arayuz-yeni"

# Yapay zekâ uygulaması (K21): iki kutu. İkisi de kaldırıldıysa --asistan geçmez, önceki seçim (yoksa Claude) sürer.
ASISTAN=""
if [ -e "$KOK/secim/asistan-claude" ] && [ -e "$KOK/secim/asistan-chatgpt" ]; then ASISTAN=ikisi
elif [ -e "$KOK/secim/asistan-chatgpt" ]; then ASISTAN=chatgpt
elif [ -e "$KOK/secim/asistan-claude" ]; then ASISTAN=claude; fi
rm -f "$KOK/secim/asistan-claude" "$KOK/secim/asistan-chatgpt"
ONCEKI_CHATGPT=0
{ [ -e "$KOK/onceki/asistan-chatgpt" ] || grep -Eq '"asistan": *"(chatgpt|ikisi)"' "$KOK/veri/durum.json" 2>/dev/null; } && ONCEKI_CHATGPT=1

SECIM=""
for f in "$KOK"/secim/*; do
  [ -e "$f" ] && SECIM="$SECIM${SECIM:+,}$(basename "$f")"
done
rm -rf "$KOK/secim"

DIL=$(defaults read -g AppleLanguages 2>/dev/null | sed -n '2p' | tr -d ' ",' | cut -c1-2)
# Kurulumun dili Mac'in ilk dilidir: Türkçe, Azerbaycanca ya da (ötekilerde) İngilizce.
case "$DIL" in tr|az) ;; *) DIL=en ;; esac

# Claude Desktop yerel sunucuları (claude_desktop_config.json) yalnız açılışta okur. Açık kalırsa kurulumun yazdığı
# kaydı görmez: ilk kurulumda ArthurLegal'siz, güncellemede önceki sürümün sunucusuyla sürer ve son adımdaki
# "ArthurLegal Masası'nı aç" mesajı masayı bulamaz. Windows kurulumundaki gibi kayıttan önce kapatılır; son adım
# (kisayol baslat) onu yeniden açar. Önce SIGTERM (Electron bunu Cmd+Q gibi düzgün çıkış sayar), 10 saniyede
# kapanmazsa zorla. Yalnız bu kullanıcının Claude Desktop'u: Claude Code'un süreci küçük harfli "claude"dır
# (ortak.claude_calisiyor ile aynı ölçüt).
KULLANICI=$(id -u)
if /usr/bin/pgrep -x -U "$KULLANICI" Claude >/dev/null 2>&1; then
  /usr/bin/pkill -TERM -x -U "$KULLANICI" Claude
  for _ in $(seq 1 20); do
    /usr/bin/pgrep -x -U "$KULLANICI" Claude >/dev/null 2>&1 || break
    sleep 0.5
  done
  if /usr/bin/pgrep -x -U "$KULLANICI" Claude >/dev/null 2>&1; then
    /usr/bin/pkill -KILL -x -U "$KULLANICI" Claude
    sleep 1
    echo "Claude Desktop 10 saniyede kapanmadı, zorla kapatıldı"
  else
    echo "Claude Desktop kapatıldı; kurulumun sonunda yeniden açılır"
  fi
fi

# ChatGPT masaüstü de ayarını (~/.codex/config.toml) ve yerel sunucuları yalnız açılışta okur. Seçimde ChatGPT varsa
# ya da önceki seçimde vardıysa (K30: kaldırılıyor) aynı yolla kapatılır. Süreç adı "ChatGPT" (eski adıyla "Codex").
if [ "$ASISTAN" = chatgpt ] || [ "$ASISTAN" = ikisi ] || [ "$ONCEKI_CHATGPT" = 1 ]; then
  for AD in ChatGPT Codex; do
    if /usr/bin/pgrep -x -U "$KULLANICI" "$AD" >/dev/null 2>&1; then
      /usr/bin/pkill -TERM -x -U "$KULLANICI" "$AD"
      for _ in $(seq 1 20); do
        /usr/bin/pgrep -x -U "$KULLANICI" "$AD" >/dev/null 2>&1 || break
        sleep 0.5
      done
      /usr/bin/pgrep -x -U "$KULLANICI" "$AD" >/dev/null 2>&1 && /usr/bin/pkill -KILL -x -U "$KULLANICI" "$AD"
      echo "$AD kapatıldı"
    fi
  done
fi

rm -f "$KOK/aktif.txt"
"$KOK/runtime/bin/python3" -B "$KOK/bin/al.py" kur --kurulum --kisayol --dil "$DIL" --moduller "$SECIM" --arayuz "$ARAYUZ" \
  ${ASISTAN:+--asistan "$ASISTAN"}
KOD=$?
echo "kur çıkış kodu $KOD (modüller: ${SECIM:-yok}, dil: $DIL, arayüz: $ARAYUZ, uygulama: ${ASISTAN:-önceki})"

if [ $KOD -eq 0 ]; then
  rm -rf "$KOK/onceki"
  mkdir -p "$KOK/onceki"
  for m in ${SECIM//,/ }; do : > "$KOK/onceki/$m"; done
  [ "$ARAYUZ" = klasik ] && : > "$KOK/onceki/arayuz-klasik"
  # Uygulama kutuları boş bırakıldıysa kur.py önceki seçimle sürdü: işaret durum.json'daki seçimden yazılır.
  SON=${ASISTAN:-$(sed -n 's/.*"asistan": *"\([a-z]*\)".*/\1/p' "$KOK/veri/durum.json" 2>/dev/null | head -1)}
  case "$SON" in claude) : > "$KOK/onceki/asistan-claude" ;; chatgpt) : > "$KOK/onceki/asistan-chatgpt" ;;
    ikisi) : > "$KOK/onceki/asistan-claude"; : > "$KOK/onceki/asistan-chatgpt" ;; esac
  # Başlangıç rehberi ve seçilen uygulama (Windows'taki bitiş sayfasının kutuları gibi); arka planda.
  "$KOK/runtime/bin/python3" -B "$KOK/bin/al.py" kisayol baslat >/dev/null 2>&1 &
elif [ $KOD -eq 2 ]; then
  if [ "$DIL" = "tr" ]; then METIN="{{PAKET_YOK_TR}}"; DUGME="Tamam"
  elif [ "$DIL" = "az" ]; then METIN="{{PAKET_YOK_AZ}}"; DUGME="OK"
  else METIN="{{PAKET_YOK_EN}}"; DUGME="OK"; fi
  /usr/bin/osascript -e "display dialog \"$METIN\" buttons {\"$DUGME\"} default button 1 with icon caution" >/dev/null 2>&1 &
fi
exit 0
